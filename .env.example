# SmartPark Root Environment Template
# Backend server port
PORT=5000

# MongoDB Connection String (Atlas URI or leave empty for local in-memory fallback)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartpark?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=supersecret_smartpark_jwt_key_2026

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development

